Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.quickartphotography\.in$ [NC]
RewriteRule ^(.*)$ https://quickartphotography.in/$1 [L,R=301]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

RedirectMatch 301 ^/courses/graphic-design/?$ /courses/album-design/
RedirectMatch 301 ^/courses/graphic-design/index\.html$ /courses/album-design/

# Legacy 301 Redirects (SEO preservation for indexed pages)
RedirectMatch 301 ^/adobe-premiere-pro-course/?$ /online/premiere-pro-course/
RedirectMatch 301 ^/adobe-premiere-pro-course/index\.html$ /online/premiere-pro-course/
RedirectMatch 301 ^/best-davinci-resolve-online-course-in-hindi/?$ /online/davinci-resolve-course/
RedirectMatch 301 ^/best-davinci-resolve-online-course-in-hindi/index\.html$ /online/davinci-resolve-course/
RedirectMatch 301 ^/join-video-editing-album-design-course/?$ /online/album-design-course/
RedirectMatch 301 ^/join-video-editing-album-design-course/index\.html$ /online/album-design-course/

# Performance: static assets
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
 ExpiresActive On
 ExpiresByType image/webp "access plus 30 days"
 ExpiresByType image/jpeg "access plus 30 days"
 ExpiresByType image/png "access plus 30 days"
 ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
